# Contact form (app/api/contact/route.js). Until these two are set, the form shows an error instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional sender. Must be on a domain you have verified in Resend, for example: Mwega <hello@yourdomain>
CONTACT_FROM_EMAIL=

# Your live address, for example https://www.yourdomain (used for canonical links and the sitemap)
NEXT_PUBLIC_SITE_URL=
